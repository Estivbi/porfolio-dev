---
const EXPERIENCE = [
  {
    dateFrom: "2026",
    dateTo:   "Ahora",
    role:     "Lead Frontend · Full Stack Developer",
    company:  "CSS",
    desc:     "Modernización integral de la interfaz de un DMS con más de 25 años en el mercado (JavaScript + Figma). Liderazgo del desarrollo desde cero de un portal de APIs RESTful documentado en YAML, migración del portal corporativo a WordPress con foco en SEO y refactorización de código legacy ColdFusion a arquitectura MVC con optimización SQL. Ciclo completo con Jira, control de versiones y documentación en Confluence.",
    tags:     ["JavaScript", "APIs REST", "ColdFusion → MVC", "SQL", "WordPress", "Figma"],
  },
  {
    dateFrom: "2025",
    dateTo:   "2026",
    role:     "Desarrolladora Full Stack · DevOps",
    company:  "INDRA · Banca",
    desc:     "Frontend (JavaScript) y backend (PHP) del sistema de monitorización de un cliente bancario. Optimización de interfaces y procesos de carga de datos, tests automáticos y funcionales antes de cada despliegue y trabajo en entornos DevOps con máquinas virtuales de desarrollo, pruebas y producción.",
    tags:     ["JavaScript", "PHP", "Testing", "DevOps", "Linux"],
  },
  {
    dateFrom: "2025",
    dateTo:   "Ahora",
    role:     "Co-fundadora · Full Stack Dev",
    company:  "REVISTA VICTORIA",
    desc:     "Diseño y desarrollo desde cero de la plataforma de una revista de moda independiente: SEO-first, gestión de contenidos a medida para el equipo de redacción, mantenimiento continuo y soporte técnico.",
    tags:     ["Astro", "React", "Sanity", "SEO"],
    link:     "https://www.victoriarevista.com/",
  },
  {
    dateFrom: "2023",
    dateTo:   "2025",
    role:     "Desarrolladora Full Stack",
    company:  "ME ASESORAN",
    desc:     "Desarrollo de Me Asesoran Rentas: backend y frontend, integración con la API y el sistema de autenticación del gobierno de España, y validación y envío de declaraciones por parte de asesores fiscales. Trabajo cercano con producto.",
    tags:     ["Next.js", "React Native", "Tailwind", "API AEAT"],
    link:     "https://rentas.measesoran.eu",
  },
]
---

<div class="exp-list">
  {EXPERIENCE.map((exp, i) => (
    <div class={`exp-item r-left d${i + 1}`}>
      <div class="exp-date">{exp.dateFrom}<br/>→ {exp.dateTo}</div>
      <div>
        <div class="exp-role">{exp.role}</div>
        <div class="exp-company">{exp.company}</div>
        <p class="exp-desc">{exp.desc}</p>
        <div class="exp-tags">
          {exp.tags.map(tag => <span class="exp-tag">{tag}</span>)}
        </div>
      </div>
    </div>
  ))}
</div>

<style>
  .exp-list { display: flex; flex-direction: column; }

  .exp-item {
    display: grid; grid-template-columns: 160px 1fr;
    gap: 3rem; padding: 2rem 0;
    border-top: 1px solid var(--border);
    position: relative; transition: background .2s, padding .2s;
  }
  .exp-item:last-child { border-bottom: 1px solid var(--border); }
  .exp-item::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    width: 2px; background: var(--accent);
    transform: scaleY(0); transform-origin: top;
    transition: transform .35s cubic-bezier(.4,0,.2,1);
  }
  .exp-item:hover::before { transform: scaleY(1); }
  .exp-item:hover {
    background: var(--accent-lo);
    padding-left: 1rem;
  }

  .exp-date {
    font-family: 'JetBrains Mono', monospace;
    font-size: .68rem; color: var(--muted); letter-spacing: .05em;
    padding-top: .2rem; line-height: 1.6;
  }
  .exp-role    { font-size: 1rem; font-weight: 600; color: var(--white); margin-bottom: .2rem; letter-spacing: -.01em; }
  .exp-company { font-family: 'JetBrains Mono', monospace; font-size: .72rem; color: var(--accent); letter-spacing: .08em; margin-bottom: .9rem; }
  .exp-desc    { font-size: .82rem; line-height: 1.8; color: var(--muted2); }

  .exp-tags { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .9rem; }
  .exp-tag  {
    font-size: .65rem; padding: .2rem .55rem;
    border: 1px solid var(--border2); color: var(--muted);
    border-radius: 8px; font-family: 'JetBrains Mono', monospace;
  }

  @media(max-width: 900px) {
    .exp-item  { grid-template-columns: 1fr; gap: .5rem; padding: 1.25rem 0; }
    .exp-date  { display: none; }
  }
</style>
