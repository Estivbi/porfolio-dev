---
interface Project {
  num:      string
  title:    string
  tags:     string[]
  desc:     string
  image?:   string
  link?:    string
  github?:  string
  wide?:    boolean
  featured?: boolean
  codeBlock?: boolean
}

const PROJECTS: Project[] = [
  {
    num:      "project_01",
    title:    "Me Asesoran Rentas",
    tags:     ["Next.js", "React Native", "Tailwind", "APIs AEAT"],
    desc:     "Plataforma fiscal real en producción. Integración con APIs oficiales de la Agencia Tributaria, sistema de autenticación oficial, validaciones complejas y panel exclusivo para asesores. Miles de usuarios activos.",
    image:    "/projects/rentasapp.png",
    link:     "https://rentas.measesoran.eu",
    wide:     true,
    featured: true,
  },
  {
    num:      "project_02",
    title:    "Indra, sistema de monitorización",
    tags:     ["JavaScript", "PHP", "Testing", "DevOps"],
    desc:     "Sistema de monitorización para un cliente bancario. Mejoras de frontend y backend, optimización de interfaces y de la carga de datos, y tests automáticos antes de cada despliegue.",
    image:    "/projects/stack-indra.png",
  },
  {
    num:      "project_03",
    title:    "Revista Victoria",
    tags:     ["Astro", "React", "Sanity CMS"],
    desc:     "Plataforma editorial independiente construida desde cero. Performance-first, rutas dinámicas y diseño editorial custom. Producto propio en producción.",
    image:    "/projects/revistavictoria.png",
    link:     "https://www.victoriarevista.com/",
  },
  {
    num:      "project_04 · Stibios · Producto propio",
    title:    "Stibios Agent Platform",
    tags:     ["Python", "LangGraph", "FastAPI", "Celery", "Redis", "Supabase", "Gemini", "Docker"],
    desc:     "Plataforma de agentes autónomos 24/7 que gestiona operativa y contenido de todos los proyectos Stibios. 5 agentes en producción: Dev Briefing, News Intelligence, Blog Stibios, Blog Victoria y Lead Generation. Cada agente es un grafo LangGraph independiente con observabilidad completa y alertas Telegram.",
    link:     "https://stibios.com",
    codeBlock: true,
  },
  {
    num:      "project_05",
    title:    "AgentVuelosBot",
    tags:     ["Python", "FastAPI", "PostgreSQL", "Telegram"],
    desc:     "Sistema de alertas inteligentes para vuelos baratos. Backend en Python + FastAPI, bot conversacional en Telegram y base de datos PostgreSQL. Los usuarios crean alertas personalizadas según origen, destino, fechas y precio objetivo.",
    link:     "https://web.telegram.org/k/#@AgentVuelosBot",
    github:   "https://github.com/Estivbi/bot-agenteviajes",
    image:    "/projects/avatarbot.png",
  },
]
---

<ul class="projects">
  {PROJECTS.map(p => (
    <li>
      <div class="info">
        <h3>{p.title}</h3>
        <p class="desc">{p.desc}</p>
        <p class="tags">{p.tags.join(", ")}</p>
        <p class="links">
          {p.link && <a href={p.link} target="_blank" rel="noopener">Ver en vivo</a>}
          {p.github && <a href={p.github} target="_blank" rel="noopener">Código en GitHub</a>}
        </p>
      </div>
      <div class="visual">
        {p.codeBlock ? (
          <pre class="agents">{`agentes en producción
  dev_briefing       ok
  news_intelligence  ok
  blog_stibios       ok
  blog_victoria      ok
  lead_generation    ok
infra: Hetzner, Docker, Redis, Supabase`}</pre>
        ) : p.image ? (
          <img src={p.image} alt={p.title} loading="lazy" />
        ) : null}
      </div>
    </li>
  ))}
</ul>

<style>
  .projects { list-style: none; border-top: 1px solid var(--line); }
  li { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(1.5rem, 4vw, 3.5rem); padding: 2rem 0; border-bottom: 1px solid var(--line); align-items: start; }
  h3 { font-family: var(--display); font-weight: 600; font-size: 1.5rem; letter-spacing: -.02em; line-height: 1.2; margin-bottom: .6rem; }
  .desc { max-width: 58ch; }
  .tags { margin-top: .75rem; font-family: var(--mono); font-size: .75rem; color: var(--muted); }
  .links { margin-top: 1rem; display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .links a { font-weight: 500; text-underline-offset: 4px; }
  .links a:hover { color: var(--accent); }
  .visual img { width: 100%; height: 230px; object-fit: cover; object-position: top; border: 1px solid var(--line); border-radius: 4px; display: block; }
  .agents { background: var(--ink); color: #c9d0da; border-radius: 4px; padding: 1.25rem; font-family: var(--mono); font-size: .75rem; line-height: 1.9; overflow-x: auto; min-height: 230px; }
  @media (max-width: 760px) { li { grid-template-columns: 1fr; } .visual img, .agents { height: auto; min-height: 0; } }
</style>
