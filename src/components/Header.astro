---
const navItems = [
  { title: "Qué resuelvo", url: "/#servicios" },
  { title: "Trabajo",      url: "/#trabajo" },
  { title: "Proyectos",    url: "/#proyectos" },
  { title: "Sobre mí",     url: "/#sobre-mi" },
]
---

<header class="top">
  <div class="wrap bar">
    <a href="/" class="logo">Carolina Rodríguez</a>
    <nav aria-label="Principal">
      <ul>
        {navItems.map(l => <li><a href={l.url}>{l.title}</a></li>)}
        <li><a href="mailto:carolinarb1994@gmail.com" class="cta">Escríbeme</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .top { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; justify-content: space-between; align-items: center; height: 60px; }
  .logo { font-family: var(--display); font-weight: 700; font-size: 1.05rem; letter-spacing: -.01em; text-decoration: none; }
  ul { display: flex; align-items: center; gap: 1.75rem; list-style: none; }
  nav a { font-size: .9rem; text-decoration: none; color: var(--muted); transition: color .15s; }
  nav a:hover { color: var(--ink); }
  .cta { color: #fff; background: var(--accent); padding: .45rem .95rem; border-radius: 4px; font-weight: 500; }
  nav a.cta:hover { color: #fff; background: #1a30d0; }
  @media (max-width: 760px) { li:not(:last-child) { display: none; } }
</style>
