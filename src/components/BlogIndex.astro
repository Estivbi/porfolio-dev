---
import { getCollection } from 'astro:content'
import Layout from '../layouts/Layout.astro'
import { getDict, path, type Lang } from '../i18n'
const { lang } = Astro.props as { lang: Lang }
const d = getDict(lang)
const posts = (await getCollection('blog', p => p.data.lang === lang && !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<Layout lang={lang} route="/blog/" title={`${d.blog.title} · Carolina Rodríguez`}>
  <section class="section wrap">
    <h1 class="h2">{d.blog.title}</h1>
    <p class="mb-12 max-w-[52ch] text-s1 text-niebla">{d.blog.intro}</p>
    {posts.length === 0 ? (
      <p class="font-mono text-sm text-niebla">{d.blog.empty}</p>
    ) : (
      <ul class="border-t border-riel">
        {posts.map(p => (
          <li class="border-b border-riel py-5">
            <p class="font-mono text-xs text-niebla">{p.data.date.toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-GB')}</p>
            <p class="text-s2 font-semibold">{p.data.title}</p>
            <p class="text-niebla">{p.data.description}</p>
          </li>
        ))}
      </ul>
    )}
    <a href={path(lang, '/')} class="mt-12 inline-block underline underline-offset-4">{d.blog.back}</a>
  </section>
</Layout>
