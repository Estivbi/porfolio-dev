---
import { getDict, type Lang } from '../i18n'
const { lang } = Astro.props as { lang: Lang }
const d = getDict(lang)
const agents = ['dev_briefing', 'news_intelligence', 'blog_stibios', 'blog_victoria', 'lead_generation']
---

<section id="proyectos" class="section wrap scroll-mt-14">
  <h2 class="h2">{d.work.title}</h2>

  <ul class="space-y-20 md:space-y-28">
    {d.work.items.map((p, i) => (
      <li class="grid items-center gap-8 lg:grid-cols-2 lg:gap-16">
        <div class={i % 2 ? 'lg:order-2' : ''}>
          <h3 class="text-s3 font-semibold tracking-tight">{p.name}</h3>
          <p class="mt-4 max-w-[52ch] text-s1 text-papel/90">{p.text}</p>
          {p.tags.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-2">{p.tags.map(t => <li class="chip">{t}</li>)}</ul>
          )}
          {p.url && (
            <a href={p.url} target="_blank" rel="noopener" class="mt-6 inline-block underline underline-offset-4 decoration-riel transition-colors hover:decoration-ambar">
              {d.work.visit} ↗
            </a>
          )}
        </div>

        <div class="frame">
          <div class="bar">
            <span class="station" aria-hidden="true" style="width:9px;height:9px;border-width:1.5px"></span>
            <span class="url">{p.url ? p.url.replace('https://', '') : 'madring…'}</span>
          </div>
          <div class="screen">
            {p.name === 'Stibios Agent Platform' ? (
              <ul class="font-mono text-xs leading-8 text-niebla">
                {agents.map(a => (
                  <li class="flex items-center justify-between gap-6">
                    <span class="text-papel">{a}</span>
                    <span class="flex items-center gap-2 text-envivo"><span class="live" aria-hidden="true"></span>online</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="font-mono text-xs text-niebla">{d.work.pending}</p>
            )}
          </div>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .frame { border: 1px solid #262c37; border-radius: 6px; overflow: hidden; background: #12161d; }
  .bar { display: flex; align-items: center; gap: .75rem; padding: .6rem .9rem; border-bottom: 1px solid #262c37; }
  .url { font-family: 'Geist Mono Variable', monospace; font-size: .72rem; color: #9aa3b2; background: #0a0c10; border-radius: 3px; padding: .2rem .6rem; flex: 1; }
  .screen { min-height: 16rem; padding: 1.5rem; display: flex; align-items: center; }
  .screen > * { width: 100%; }
  .live { width: 7px; height: 7px; border-radius: 50%; background: #3dd6b0; animation: pulso 2s ease-in-out infinite; }
  @keyframes pulso { 50% { opacity: .35; } }
</style>
