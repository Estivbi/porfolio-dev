---
---

<section class="hero">
  <!-- mesh gradient background -->
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-left">
    <div class="hero-eyebrow">
      <div class="live-dot"></div>
      disponible para trabajar · Madrid, España
    </div>

    <h1 class="hero-h1">
      Carolina<br/>Rodríguez<br/>
      <span class="dim">AI Engineer.</span>
    </h1>

    <p class="hero-sub">
      Construyo sistemas con IA que <strong>funcionan en producción.</strong><br/>
      Backend, frontend, agentes LLM y despliegue: el ciclo completo, de la idea al DevOps.
    </p>

    <div class="hero-actions">
      <a href="#proyectos" class="btn btn-solid">Ver proyectos</a>
      <a href="#sobre-mi"  class="btn btn-ghost">Sobre mí</a>
      <a href="https://linkedin.com/in/carolinarodriguezbarcena" target="_blank" rel="noopener" class="btn btn-ghost">LinkedIn ↗</a>
    </div>
  </div>

  <div class="hero-right">
    <div class="hero-code">
<span class="code-key">const</span> carol = &#123;<br/>
&nbsp;&nbsp;rol:&nbsp;&nbsp;&nbsp;<span class="code-str">"AI Engineer"</span>,<br/>
&nbsp;&nbsp;studio:&nbsp;<span class="code-str">"Stibios"</span>,<br/>
&nbsp;&nbsp;ciclo:&nbsp;<span class="code-str">"back → front → devops"</span>,<br/>
&nbsp;&nbsp;stack:&nbsp;&nbsp;<span class="code-str">"Python · LLM · React"</span>,<br/>
&nbsp;&nbsp;AI:&nbsp;&nbsp;&nbsp;&nbsp;<span class="code-bool">true</span>,<br/>
&nbsp;&nbsp;open:&nbsp;&nbsp;<span class="code-bool">true</span>,<br/>
&#125;;
    </div>
  </div>

</section>

<style>
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    column-gap: 4rem;
    padding: 0 5vw;
    padding-top: 56px;
    position: relative;
  }

  .hero-left  { display: flex; flex-direction: column; justify-content: center; position: relative; z-index: 1; }
  .hero-right { display: flex; align-items: center; justify-content: flex-end; position: relative; z-index: 1; }

  /* MESH GRADIENT */
  .hero-bg {
    position: absolute; inset: 0; overflow: hidden;
    pointer-events: none; z-index: 0;
    opacity: 0; animation: meshfade 1.4s 0.8s forwards;
    /* fade to page background at the bottom */
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 55%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 0%, black 55%, transparent 100%);
  }

  .hero-bg::before {
    content: '';
    position: absolute;
    inset: -20px;
    background-image:
      radial-gradient(72% 58% at 16% 82%, #06b6d4bb 0%, #06b6d455 22%, #06b6d400 72%),
      radial-gradient(68% 52% at 82% 14%, #3b82f6aa 0%, #3b82f640 22%, #3b82f600 72%),
      radial-gradient(60% 50% at 8%  18%, #0ea5e988 0%, #0ea5e930 22%, #0ea5e900 72%),
      radial-gradient(55% 48% at 90% 78%, #4f46e577 0%, #4f46e528 22%, #4f46e500 72%),
      radial-gradient(50% 44% at 50% 48%, #2563eb44 0%, #2563eb18 22%, #2563eb00 72%),
      radial-gradient(42% 38% at 68% 55%, #7c6ef733 0%, #7c6ef712 22%, #7c6ef700 72%);
    filter: blur(8px);
    animation: meshdrift 20s 2.2s ease-in-out infinite alternate;
  }

  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/png;base64,");
    mix-blend-mode: overlay;
    opacity: 0.035;
  }

  @keyframes meshfade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes meshdrift {
    0%   { transform: translate(0%,    0%)   scale(1); }
    25%  { transform: translate(2.5%,  -3%)  scale(1.04); }
    50%  { transform: translate(-3%,   2%)   scale(1.02); }
    75%  { transform: translate(1.5%,  3.5%) scale(1.05); }
    100% { transform: translate(-2%,  -1.5%) scale(1.03); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg { animation: meshfade 1.4s 0.8s forwards; }
    .hero-bg::before { animation: none; }
  }

  .hero-code {
    background: linear-gradient(135deg, rgba(124,110,247,.06) 0%, rgba(79,70,229,.04) 50%, rgba(192,38,211,.03) 100%), var(--bg2);
    border: 1px solid rgba(124,110,247,.2);
    border-radius: 18px; padding: 1.5rem 1.75rem;
    font-family: 'JetBrains Mono', monospace; font-size: .72rem;
    line-height: 2; color: var(--muted2);
    white-space: nowrap;
    opacity: 0; animation: up .7s 1.1s forwards;
  }

  .hero-eyebrow {
    display: inline-flex; align-items: center; gap: .6rem;
    font-family: 'JetBrains Mono', monospace; font-size: .72rem;
    color: var(--muted2); letter-spacing: .08em; margin-bottom: 2.5rem;
    opacity: 0; animation: up .6s .2s forwards;
  }
  .live-dot {
    width: 6px; height: 6px; background: var(--green); border-radius: 50%;
    animation: livepulse 2s infinite;
  }

  .hero-h1 {
    font-size: clamp(3.5rem, 9vw, 8rem);
    font-weight: 600; line-height: 1.0; letter-spacing: -.03em;
    color: var(--white); margin-bottom: 1.75rem;
    opacity: 0; animation: up .7s .35s forwards;
  }
  .hero-h1 .dim { color: var(--muted); font-weight: 300; }

  .hero-sub {
    font-size: 1.05rem; line-height: 1.75; color: var(--muted2);
    max-width: 560px; margin-bottom: 2.5rem;
    opacity: 0; animation: up .7s .5s forwards;
  }
  .hero-sub strong { color: var(--text); font-weight: 500; }

  .hero-actions {
    display: flex; gap: .75rem; flex-wrap: wrap;
    opacity: 0; animation: up .6s .65s forwards;
  }

  .btn {
    display: inline-flex; align-items: center; gap: .4rem;
    font-size: .8rem; font-weight: 500; text-decoration: none;
    border-radius: 8px; padding: .6rem 1.25rem; transition: all .2s; cursor: none;
  }
  .btn-solid { background: var(--accent); color: var(--white); }
  .btn-solid:hover { background: #8f84f9; transform: translateY(-1px); box-shadow: 0 6px 20px rgba(124,110,247,.3); }
  .btn-ghost { background: transparent; color: var(--muted2); border: 1px solid var(--border2); }
  .btn-ghost:hover { color: var(--white); background: var(--bg2); }

.code-key  { color: var(--accent); }
  .code-str  { color: #f9a870; }
  .code-bool { color: var(--green); }

  @media(max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 0 1.25rem 2rem;
      padding-top: 56px;
      min-height: auto;
    }
    .hero-right  { display: none; }
    .hero-eyebrow { margin-bottom: 1.25rem; }
    .hero-h1     { margin-bottom: 1rem; }
    .hero-sub    { margin-bottom: 1.5rem; font-size: .95rem; }
  }
</style>
