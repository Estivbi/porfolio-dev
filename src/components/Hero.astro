---
const FACTS = [
  { k: "Rol",        v: "AI Engineer · Full Stack" },
  { k: "Cubro",      v: "Backend → Frontend → DevOps" },
  { k: "Stack IA",   v: "Python · LangGraph · LLMs" },
  { k: "Base",       v: "Madrid · remoto / híbrido" },
  { k: "Disponible", v: "Sí, para nuevos proyectos" },
]
---

<section class="hero">
  <div class="hero-left">
    <div class="hero-eyebrow">
      <span class="live-dot"></span>
      Carolina Rodríguez · AI Engineer
    </div>

    <h1 class="hero-h1">
      Diseño, construyo y despliego <span class="hl">sistemas con IA</span> de extremo a extremo.
    </h1>

    <p class="hero-sub">
      Agentes LLM, APIs, interfaces e infraestructura: un solo perfil para llevar
      una idea de IA desde el prototipo hasta producción, sin saltos entre equipos.
    </p>

    <div class="hero-actions">
      <a href="mailto:carolinarb1994@gmail.com" class="btn btn-solid">Hablemos →</a>
      <a href="/cv-carolina-rodriguez.pdf" class="btn btn-ghost" download>Descargar CV</a>
      <a href="#proyectos" class="btn btn-ghost">Ver proyectos</a>
    </div>
  </div>

  <aside class="hero-card" aria-label="Resumen">
    <div class="hero-card-head">media kit</div>
    <dl>
      {FACTS.map(f => (
        <div class="fact"><dt>{f.k}</dt><dd>{f.v}</dd></div>
      ))}
    </dl>
  </aside>
</section>

<style>
  .hero {
    min-height: 88vh;
    display: grid;
    grid-template-columns: 1fr 340px;
    align-items: center;
    column-gap: 5rem;
    padding: 56px 5vw 0;
    max-width: 1400px; margin: 0 auto;
  }

  .hero-eyebrow {
    display: inline-flex; align-items: center; gap: .6rem;
    font-family: 'JetBrains Mono', monospace; font-size: .72rem;
    color: var(--muted2); letter-spacing: .06em; margin-bottom: 1.75rem;
  }
  .live-dot {
    width: 6px; height: 6px; background: var(--green); border-radius: 50%;
    animation: livepulse 2s infinite;
  }

  .hero-h1 {
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 600; line-height: 1.08; letter-spacing: -.03em;
    color: var(--white); margin-bottom: 1.5rem; max-width: 820px;
  }
  .hero-h1 .hl { color: var(--accent); }

  .hero-sub {
    font-size: 1.05rem; line-height: 1.7; color: var(--muted2);
    max-width: 560px; margin-bottom: 2.25rem;
  }

  .hero-actions { display: flex; gap: .75rem; flex-wrap: wrap; }

  .btn {
    display: inline-flex; align-items: center; gap: .4rem;
    font-size: .85rem; font-weight: 500; text-decoration: none;
    border-radius: 6px; padding: .7rem 1.25rem; transition: all .2s;
  }
  .btn-solid { background: var(--accent); color: #07110f; }
  .btn-solid:hover { background: #52c7b9; }
  .btn-ghost { color: var(--text); border: 1px solid var(--border2); }
  .btn-ghost:hover { background: var(--bg2); border-color: var(--muted); }

  .hero-card {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 8px; padding: 1.25rem 1.5rem;
  }
  .hero-card-head {
    font-family: 'JetBrains Mono', monospace; font-size: .65rem;
    letter-spacing: .14em; text-transform: uppercase; color: var(--accent);
    padding-bottom: .9rem; border-bottom: 1px solid var(--border);
  }
  .fact { padding: .8rem 0; border-bottom: 1px solid var(--border); }
  .fact:last-child { border-bottom: none; padding-bottom: 0; }
  .fact dt {
    font-family: 'JetBrains Mono', monospace; font-size: .62rem;
    letter-spacing: .1em; text-transform: uppercase; color: var(--muted);
    margin-bottom: .2rem;
  }
  .fact dd { font-size: .88rem; color: var(--text); }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr; min-height: auto;
      padding: 56px 1.25rem 2rem; row-gap: 2rem;
    }
    .hero-eyebrow { margin-bottom: 1.25rem; }
    .hero-sub { font-size: .95rem; margin-bottom: 1.5rem; }
  }
</style>
