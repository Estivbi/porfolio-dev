---
interface Props {
  title: string
  description: string
}

const { description, title } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet" />
  </head>

  <body>
    <slot />

    <style is:global>
      :root {
        --bg:        #0c0d0f;
        --bg2:       #111316;
        --bg3:       #16191d;
        --border:    rgba(255,255,255,0.08);
        --border2:   rgba(255,255,255,0.14);
        --text:      #d9dce1;
        --muted:     #6b717c;
        --muted2:    #9097a3;
        --accent:    #3fb6a8;
        --accent-lo: rgba(63,182,168,0.08);
        --white:     #f4f5f7;
        --green:     #3fb6a8;
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; font-size: 16px; }
      body {
        background: var(--bg);
        color: var(--text);
        font-family: 'Geist', 'Inter', sans-serif;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
      }

      /* DIVIDER */
      .divider { height: 1px; background: var(--border); margin: 0 5vw; }

      /* SCROLL REVEAL */
      .r       { opacity: 0; transform: translateY(28px); transition: opacity .7s cubic-bezier(.4,0,.2,1), transform .7s cubic-bezier(.4,0,.2,1); }
      .r.in    { opacity: 1; transform: none; }
      .r-clip  { clip-path: inset(0 0 100% 0); transition: clip-path .85s cubic-bezier(.77,0,.175,1); }
      .r-clip.in { clip-path: inset(0 0 0% 0); }
      .r-left  { opacity: 0; transform: translateX(-28px); transition: opacity .65s ease, transform .65s ease; }
      .r-left.in { opacity: 1; transform: none; }
      .d1 { transition-delay: .07s }
      .d2 { transition-delay: .14s }
      .d3 { transition-delay: .21s }
      .d4 { transition-delay: .28s }
      .d5 { transition-delay: .35s }

      @keyframes up { to { opacity: 1; transform: translateY(0); } }
      @keyframes livepulse {
        0%,100% { box-shadow: 0 0 0 0 rgba(74,222,128,.4) }
        50%      { box-shadow: 0 0 0 5px rgba(74,222,128,0) }
      }
    </style>

    <script>
      // Scroll reveal
      const io = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target) }
        })
      }, { threshold: .08, rootMargin: '0px 0px -30px 0px' })
      document.querySelectorAll('.r,.r-clip,.r-left').forEach(el => io.observe(el))
    </script>
  </body>
</html>
