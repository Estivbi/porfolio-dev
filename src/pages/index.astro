---
import Layout     from "@/layouts/Layout.astro"
import Header     from "@/components/Header.astro"
import Hero       from "@/components/Hero.astro"
import Experience from "@/components/Experience.astro"
import Projects   from "@/components/Projects.astro"
import AboutMe    from "@/components/AboutMe.astro"
import Footer     from "@/components/Footer.astro"

const SOLVES = [
  {
    problem: "Un sistema antiguo que frena al negocio",
    what:    "Lo modernizo sin pararlo: paso código legacy a una arquitectura mantenible, documento las APIs y renuevo la interfaz.",
  },
  {
    problem: "Un producto que hay que sacar desde cero",
    what:    "Lo diseño y lo construyo entero: interfaz, backend, base de datos y despliegue, con una sola persona responsable.",
  },
  {
    problem: "Tareas repetitivas que se comen horas",
    what:    "Automatizaciones y agentes con IA que trabajan solos, con reintentos, trazas y avisos cuando algo falla.",
  },
  {
    problem: "Una integración con un tercero complicada",
    what:    "APIs oficiales, autenticación y validaciones. Lo he hecho con la Agencia Tributaria, en producción.",
  },
]
---

<Layout
  title="Carolina Rodríguez · Desarrolladora Full Stack"
  description="Desarrolladora full stack en Madrid. Interfaces, APIs, datos y despliegue, y agentes y automatizaciones con IA cuando aportan valor."
>
  <Header />

  <main>
    <Hero />

    <section class="block" id="servicios">
      <div class="wrap">
        <h2 class="h2">Qué problemas resuelvo</h2>
        <dl class="solves">
          {SOLVES.map(s => (
            <div class="row">
              <dt>{s.problem}</dt>
              <dd>{s.what}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="block" id="trabajo">
      <div class="wrap">
        <h2 class="h2">Dónde lo he hecho</h2>
        <Experience />
      </div>
    </section>

    <section class="block" id="proyectos">
      <div class="wrap">
        <h2 class="h2">Proyectos en producción</h2>
        <Projects />
      </div>
    </section>

    <section class="block" id="sobre-mi">
      <div class="wrap">
        <h2 class="h2">Sobre mí</h2>
        <AboutMe />
      </div>
    </section>

    <section class="block contact" id="contacto">
      <div class="wrap">
        <h2 class="big">Si tienes algo que construir o arreglar, hablamos.</h2>
        <p class="lead">Cuéntame qué necesitas y te respondo con una propuesta de por dónde empezar.</p>
        <p class="mail"><a href="mailto:carolinarb1994@gmail.com">carolinarb1994@gmail.com</a></p>
        <p class="links">
          <a href="https://linkedin.com/in/carolinarodriguezbarcena" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://github.com/Estivbi" target="_blank" rel="noopener">GitHub</a>
          <a href="/cv-carolina-rodriguez.pdf" download>CV en PDF</a>
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .solves { border-top: 1px solid var(--line); }
  .row {
    display: grid; grid-template-columns: 1fr 1.3fr; gap: 2rem;
    padding: 1.5rem 0; border-bottom: 1px solid var(--line);
  }
  dt { font-family: var(--display); font-weight: 600; font-size: 1.3rem; line-height: 1.2; letter-spacing: -.015em; }
  dd { color: var(--muted); max-width: 56ch; }

  .contact { background: var(--ink); color: var(--bg); border-top: none; }
  .contact .lead { color: #a9b0bb; }
  .big {
    font-family: var(--display); font-weight: 700; letter-spacing: -.035em;
    font-size: clamp(2.2rem, 6vw, 4.6rem); line-height: 1.02;
    max-width: 16ch; margin-bottom: 1.25rem; text-wrap: balance;
  }
  .mail { margin: 2rem 0 1.25rem; }
  .mail a {
    font-family: var(--display); font-weight: 600; font-size: clamp(1.3rem, 3vw, 2rem);
    text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 3px; text-underline-offset: 6px;
  }
  .mail a:hover { color: #fff; }
  .links { display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .links a { color: #a9b0bb; text-underline-offset: 4px; }
  .links a:hover { color: #fff; }

  @media (max-width: 760px) { .row { grid-template-columns: 1fr; gap: .5rem; } }
</style>
